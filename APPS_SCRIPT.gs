/**
 * Планета Игр — Купчино
 * Принимает заявки с сайта и записывает их строкой в лист «Заявки».
 *
 * УСТАНОВКА (один раз, 5 минут):
 * 1. Откройте таблицу «Планета Игр Купчино — Заявки и статистика».
 * 2. Меню Расширения → Apps Script.
 * 3. Удалите весь код по умолчанию (Code.gs) и вставьте сюда весь этот файл целиком.
 * 4. Сохраните проект (значок дискеты), можно назвать «Заявки Планета Игр».
 * 5. Нажмите «Развернуть» → «Новое развёртывание».
 * 6. Тип развёртывания — выберите «Веб-приложение».
 * 7. «Выполнять как»: Я (ваш аккаунт).
 *    «У кого есть доступ»: Все (это обязательно — иначе сайт не сможет отправлять данные).
 * 8. Нажмите «Развернуть». Google попросит авторизовать доступ:
 *    выберите свой аккаунт → «Дополнительно» → «Перейти на страницу проекта (небезопасно)» → «Разрешить».
 *    Это предупреждение стандартное для собственных Apps Script проектов, бояться не нужно.
 * 9. Скопируйте появившийся URL веб-приложения (заканчивается на /exec) и пришлите его — 
 *    я вставлю его в код сайта, и заявки начнут приходить в таблицу автоматически.
 *
 * Если позже понадобится изменить код — после правок нужно снова
 * «Развернуть» → «Управление развёртываниями» → значок карандаша → «Новая версия» → «Развернуть».
 */

function doPost(e) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Заявки');
  var data = {};

  try {
    data = JSON.parse(e.postData.contents);
  } catch (err) {
    data = e.parameter || {};
  }

  sheet.appendRow([
    new Date(),                    // Дата заявки
    data.fio || '',                // ФИО
    data.phone || '',              // Телефон
    data.childName || '',          // Имя именинника
    data.childBday || '',          // Дата рождения именинника
    data.eventDate || '',          // Желаемая дата праздника
    data.eventTime || '',          // Время начала
    data.packName || '',           // Пакет
    data.roomName || '',           // Банкетная комната
    data.extrasNames || '',        // Доп. услуги
    data.durationText || '',       // Длительность
    data.endTimeText || '',        // Время окончания (примерно)
    data.priceText || '',          // Стоимость (примерно)
    data.promo || '',              // Промокод
    data.comment || '',            // Комментарий
    'Новая'                        // Статус
  ]);

  return ContentService
    .createTextOutput(JSON.stringify({ status: 'ok' }))
    .setMimeType(ContentService.MimeType.JSON);
}

function doGet(e) {
  return ContentService.createTextOutput('Планета Игр — приём заявок работает.');
}
