  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta name="theme-color" content="#f7f3ea" />
  <link rel="preconnect" href={SITE} />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
