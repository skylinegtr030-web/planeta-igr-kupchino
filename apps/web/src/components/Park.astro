<section class="scene" id="park" aria-labelledby="park-h">
  <div class="wrap">
    <div class="scene-head">
      <div>
        <span class="label rv"><i class="dot"></i>Парк</span>
        <h2 id="park-h" class="h-display h-2 rv rv-d1" style="margin-top:18px">Целый этаж<br/>приключений<br/><span class="hl">без скуки</span></h2>
      </div>
      <p class="lead rv rv-d2">Каждая зона — отдельное приключение. Наведите на название — покажем фото, нажмите — откроем всю галерею.</p>
    </div>
    <div class="zx" id="zx">
      <ol class="zx-list" id="zxList"><li class="zx-item sk" style="height:64px"></li><li class="zx-item sk" style="height:64px"></li><li class="zx-item sk" style="height:64px"></li></ol>
      <div class="zx-view">
        <div class="zx-stage" id="zxStage" role="button" tabindex="0" aria-label="Открыть галерею зоны">
          <span class="zx-num" id="zxNum"></span>
          <span class="zx-title" id="zxTitle"></span>
        </div>
        <div class="zx-strip" id="zxStrip"></div>
      </div>
    </div>
    <div class="age-line rv" id="ages"></div>
  </div>
</section>
