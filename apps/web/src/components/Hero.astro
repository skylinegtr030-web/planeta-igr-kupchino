---
import CompareScenes from './CompareScenes.astro';
---
<section class="hero" id="top">
  <div class="blobs" aria-hidden="true"><i class="blob y"></i><i class="blob b"></i><i class="blob r"></i></div>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div>
      <div class="hero-top rv in">
        <span class="label"><i class="dot"></i>Сцена 01 · Купчино</span>
        <span class="label" data-hours-label>ТРК «Балкания Nova» · 3 этаж</span>
      </div>
      <h1 class="h-display h-1 words" id="h1">
        <span class="ln"><span class="w"><span>Праздник</span></span></span>
        <span class="ln"><span class="w"><span>уровня</span></span></span>
        <span class="ln"><span class="w"><span class="hl">планеты</span></span></span>
      </h1>
      <p class="lead rv in rv-d2">Детский парк развлечений и дни рождения под ключ: звёздная башня, лабиринт с пушками, неоновая арена, банкетные комнаты и своя команда аниматоров.</p>
      <div class="hero-actions rv in rv-d3">
        <a class="btn btn-red" href="#programs">Выбрать программу <span class="ar">↓</span></a>
        <a class="btn btn-ghost" href="#rooms">Комнаты</a>
      </div>
      <div class="hero-facts rv in rv-d4">
        <div class="fact"><b data-fact="zones">—</b><span>зон парка</span></div>
        <div class="fact"><b data-fact="programs">—</b><span>программы праздника</span></div>
        <div class="fact"><b data-fact="hours">—</b><span>ежедневно</span></div>
        <div class="fact"><b data-fact="age">—</b><span>возраст гостей</span></div>
      </div>
    </div>
    <div class="strip" id="strip" aria-label="Фотографии парка">
      <div class="strip-inner" id="stripInner">
        <figure class="card-ph a sk" data-hero="0"></figure>
        <figure class="card-ph b sk" data-hero="1"></figure>
        <figure class="card-ph c sk" data-hero="2"></figure>
        <span class="sticker s1">Открыто<br/>каждый день</span>
        <span class="sticker s2">Дни рождения<br/>под ключ</span>
      </div>
    </div>
  </div>
  <div class="hero-scroll"><i></i>Листайте</div>
</section>
<section class="cmp-wrap" id="cmp" aria-labelledby="cmp-h">
  <div class="wrap">
    <div class="cmp-head">
      <div>
        <span class="label rv"><i class="dot"></i>Сравните сами</span>
        <h2 id="cmp-h" class="h-display h-2 rv rv-d1">Праздник у других<br/><span class="cmp-vs">и</span> <span class="hl">у нас</span></h2>
      </div>
      <p class="lead rv rv-d2">Потяните за ползунок. Слева — как обычно бывает. Справа — как у нас: ярко, шумно и все счастливы.</p>
    </div>
    <div class="cmp rv rv-d2" id="cmpBox" style="--x:50">
      <CompareScenes />
      <div class="cmp-tag"><b>У других</b><i>серо · тихо · скучно</i></div>
      <div class="cmp-tag right"><b>У нас</b><i>ярко · громко · все счастливы</i></div>
      <div class="cmp-handle" aria-hidden="true"><span class="cmp-knob">⟷</span></div>
      <input class="cmp-range" id="cmpRange" type="range" min="0" max="100" step="0.1" value="50" aria-label="Сравнить: у других / у нас" />
      <div class="cmp-foot"><span class="cmp-foot-a">Обычный детский праздник</span><span class="cmp-foot-b">Планета игр · Купчино</span></div>
    </div>
  </div>
</section>
