---
// Частые вопросы + текст о парке: живой контент под поисковые запросы «день рождения ребёнка Купчино», «детский парк развлечений Санкт-Петербург».
const faq = [
  ['Где отметить день рождения ребёнка в Купчино?', 'В «Планете Игр» — детском парке развлечений на 3 этаже ТРК «Балкания Nova» у метро Купчино. Есть две банкетные комнаты («Джунгли» и «Лофт»), четыре готовые программы праздника с аниматорами и безлимитный доступ в игровую зону 2 700 м² для всех гостей.'],
  ['Сколько стоит детский праздник?', 'Готовые программы дня рождения — от 24 000 ₽ в будни, в стоимость уже входят банкетная комната, безлимит в парке для детей и аниматор. Отдельно комнату можно снять от 7 000 ₽ за 2 часа. Точная сумма считается прямо в форме заявки на сайте.'],
  ['С какого возраста можно в парк?', 'Парк открыт для детей с рождения (0+): для малышей есть мягкие зоны и сухой бассейн, для старших — звёздная башня, лабиринт с пушками, скалодром, тюбинг-горка. Лазертаг Q-ZAR — с 6 лет, лавапол — с 4 лет. Дети до 4 лет находятся в парке с сопровождающим взрослым.'],
  ['Можно просто прийти поиграть, без праздника?', 'Да. Входной билет «Безлимит» на весь день — 1 500 ₽ в будни и 1 800 ₽ в выходные и праздники, тайм-карты на игровые автоматы — 30 и 60 минут. Парк работает ежедневно с 10:00 до 22:00.'],
  ['Как добраться?', 'Санкт-Петербург, Балканская ул., 17, ТРК «Балкания Nova», 3 этаж — 2 минуты пешком от метро Купчино. Есть бесплатная парковка торгового центра. Ссылки на Яндекс Карты и 2ГИС — в разделе контактов.'],
  ['Можно принести свой торт и еду?', 'Торт и напитки для детей — да, по согласованию с менеджером. В банкетных комнатах есть столы с сервировкой, можно заказать дополнения: пиццу, фонтан из шаров, пригласительные, шоу-программу.'],
];
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<section class="scene faq" id="faq">
  <i class="glow" aria-hidden="true"></i>
  <div class="wrap">
    <div class="scene-head">
      <div>
        <span class="label rv"><i class="dot"></i>Вопросы</span>
        <h2 class="h-display h-2 rv rv-d1" style="margin-top:18px">Детский праздник<br/>в <span class="hl">Купчино</span>: что важно знать</h2>
      </div>
      <p class="lead rv rv-d2">Коротко о ценах, возрасте и том, как нас найти. Если вопроса нет в списке — напишите в форме ниже.</p>
    </div>
    <div class="faq-grid">
      {faq.map(([q, a], i) => (
        <details class="faq-item rv" style={`transition-delay:${i * 0.06}s`} open={i === 0}>
          <summary><span>{q}</span><i aria-hidden="true">+</i></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
    <div class="about rv">
      <h3>Детский парк развлечений «Планета Игр» в Санкт-Петербурге</h3>
      <p>«Планета Игр» — семейный развлекательный центр во Фрунзенском районе Санкт-Петербурга, на Балканской площади рядом с метро Купчино. На 2 700 м² под одной крышей: многоуровневая звёздная башня, горки и сухой бассейн, лабиринт с пневматическими пушками, скалодром и батуты, тюбинг-горка, лазертаг Q-ZAR на неоновой арене, лавапол и игровые автоматы. Для дней рождения и детских праздников — две банкетные комнаты, программы с аниматорами, шоу мыльных пузырей, крио- и тесла-шоу, аквагрим, квесты и пиньята.</p>
      <p>Мы принимаем гостей ежедневно с 10:00 до 22:00, без выходных. Родители проходят бесплатно, в парке — зона отдыха и кофе рядом. Отметить день рождения ребёнка в Купчино, устроить выпускной детского сада или просто провести выходной с детьми в Санкт-Петербурге — заявку можно оставить онлайн за минуту.</p>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
