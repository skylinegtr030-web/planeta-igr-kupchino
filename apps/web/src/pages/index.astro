---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Park from '../components/Park.astro';
import Rooms from '../components/Rooms.astro';
import Programs from '../components/Programs.astro';
import Shows from '../components/Shows.astro';
import Tickets from '../components/Tickets.astro';
import Booking from '../components/Booking.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Планета Игр — детский парк развлечений и день рождения ребёнка в Купчино (СПб)" description="Детский парк развлечений «Планета Игр» в ТРК «Балкания Nova»: звёздная башня, лабиринт с пушками, неоновая арена, дни рождения под ключ с банкетной комнатой и аниматорами.">
  <Header />
  <main>
    <Hero />
    <Park />
    <Rooms />
    <Programs />
    <Shows />
    <Tickets />
    <Faq />
    <Booking />
  </main>
  <Footer />
</Base>
