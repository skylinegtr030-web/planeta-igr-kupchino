---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Park from '../components/Park.astro';
import Programs from '../components/Programs.astro';
import Shows from '../components/Shows.astro';
import Tickets from '../components/Tickets.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Планета Игр — детский парк развлечений и дни рождения в Купчино" description="Детский парк развлечений «Планета Игр» в ТРК «Балкания Nova»: звёздная башня, лабиринт с пушками, неоновая арена, дни рождения под ключ с банкетной комнатой и аниматорами.">
  <Header />
  <main>
    <Hero />
    <Park />
    <Programs />
    <Shows />
    <Tickets />
    <Booking />
  </main>
  <Footer />
</Base>
