{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/content",
      "destination": "/stub/content.json"
    },
    {
      "source": "/api/catalog",
      "destination": "/stub/catalog.json"
    },
    {
      "source": "/api/settings",
      "destination": "/stub/settings.json"
    },
    {
      "source": "/api/reviews",
      "destination": "/stub/reviews.json"
    }
  ]
}
